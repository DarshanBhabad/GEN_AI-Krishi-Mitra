# Copy this file to .env. Keep API credentials in the backend environment only.
# BASE_URL is the OpenAI-compatible API base URL (or a full /chat/completions URL).
API_KEY=
BASE_URL=
MODEL_ID=
EMBEDDING_MODEL_ID=
TRANSCRIPTION_MODEL_ID=
TTS_MODEL_ID=
TTS_VOICE=

# Demo mode is deliberately enabled until you explicitly configure a supported model.
DEMO_MODE=true

# Local development defaults to SQLite. Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./agri_assistant.db
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=agri_knowledge

# Configure an authorized official/partner mandi endpoint before enabling price lookups.
MANDI_API_URL=
MANDI_API_KEY=

# Set a strong value before exposing admin document upload/approval beyond localhost.
ADMIN_TOKEN=
MAX_UPLOAD_MB=15
CORS_ORIGINS=http://localhost:5173
